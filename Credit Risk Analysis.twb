      <column caption='Income Range' datatype='string' name='[Calculation_1711990421258241]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [person_income] &lt; 20000 THEN &quot;&lt;20K&quot;&#13;&#10;ELSEIF [person_income] &lt; 40000 THEN &quot;20K - 40K&quot;&#13;&#10;ELSEIF [person_income] &lt; 60000 THEN &quot;40K - 60K&quot;&#13;&#10;ELSEIF [person_income] &lt; 80000 THEN &quot;60K - 80K&quot;&#13;&#10;ELSEIF [person_income] &lt; 120000 THEN &quot;80K - 120K&quot;&#13;&#10;ELSE &quot;&gt;120K&quot;&#13;&#10;END' />
      </column>
      <column caption='Kredit/Gəlir Nisbəti Aralığı' datatype='string' name='[Calculation_1711990427799554]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [loan_percent_income] &lt;= 0.10 THEN &quot;≤ 10%&quot;&#13;&#10;ELSEIF [loan_percent_income] &lt;= 0.20 THEN &quot;10% - 20%&quot;&#13;&#10;ELSEIF [loan_percent_income] &lt;= 0.30 THEN &quot;20% - 30%&quot;&#13;&#10;ELSEIF [loan_percent_income] &lt;= 0.40 THEN &quot;30% - 40%&quot;&#13;&#10;ELSEIF [loan_percent_income] &lt;= 0.50 THEN &quot;40% - 50%&quot;&#13;&#10;ELSE &quot;&gt; 50%&quot;&#13;&#10;END' />
      </column>
      <column caption='İş stajı aralığı' datatype='string' name='[Calculation_1711990444589059]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [person_emp_length] &lt; 1 THEN &quot;&lt;1 il&quot;&#13;&#10;ELSEIF [person_emp_length] &lt;= 3 THEN &quot;1-3 il&quot;&#13;&#10;ELSEIF [person_emp_length] &lt;= 5 THEN &quot;4-5 il&quot;&#13;&#10;ELSEIF [person_emp_length] &lt;= 10 THEN &quot;6-10 il&quot;&#13;&#10;ELSE &quot;&gt;10 il&quot;&#13;&#10;END' />
      </column>
